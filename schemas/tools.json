{
  "description": "Mock Python tool contracts. Monetary fields are integer PHP centavos. Tool failures raise ToolError. These schemas document contracts; HTTP validation is minimal, not a general JSON Schema validator.",
  "tools": {
    "catalog": {
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "catalog_price": {
              "type": "integer"
            }
          },
          "required": [
            "sku",
            "name",
            "aliases",
            "catalog_price"
          ],
          "additionalProperties": false
        }
      }
    },
    "stock": {
      "input": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sku"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "sku",
          "available"
        ],
        "additionalProperties": false
      }
    },
    "quote": {
      "input": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          }
        },
        "required": [
          "owner",
          "items"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer"
                },
                "unit_price": {
                  "type": "integer"
                },
                "subtotal": {
                  "type": "integer"
                }
              },
              "required": [
                "sku",
                "quantity",
                "unit_price",
                "subtotal"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer"
          },
          "currency": {
            "const": "PHP"
          },
          "expires_at": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "owner",
          "lines",
          "total",
          "currency",
          "expires_at"
        ],
        "additionalProperties": false
      }
    },
    "place_order": {
      "input": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "quote_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "owner",
          "quote_id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quote_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "total": {
            "type": "integer"
          },
          "currency": {
            "const": "PHP"
          },
          "status": {
            "const": "placed"
          }
        },
        "required": [
          "id",
          "quote_id",
          "owner",
          "total",
          "currency",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
